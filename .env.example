DATABASE_URL=postgres://shirori:shirori@127.0.0.1:55432/shirori
SHIRORI_BIND=127.0.0.1:8080
# Accept "Authorization: Bearer dev:<role>:<name>" tokens. Never enable in production.
SHIRORI_DEV_AUTH=true
SHIRORI_DOSE_SIZE=6
SHIRORI_DISCOVER_RELATED_CAP=5
RUST_LOG=shirori_api=debug,tower_http=info
# Ingestion worker (services/ingestion)
SHIRORI_INGEST_CONCURRENCY=2
# Allows fetching private/loopback addresses. Local testing only; never in production.
SHIRORI_INGEST_ALLOW_PRIVATE=false
